{
  "name": "anishare",
  "private": true,
  "version": "0.1.0",
  "description": "内网番剧库 —— 浏览 ~/bangumi 并在线播放（H.264 / H.265 / 外挂字幕）",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "setup:ffmpeg": "node scripts/install-ffmpeg.mjs",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web"
  }
}
