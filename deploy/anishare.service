[Unit]
Description=AniShare API 后端
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sakana
WorkingDirectory=/home/sakana/workspace/anishare
EnvironmentFile=/home/sakana/workspace/anishare/server/.env
# 先执行 npm --prefix server run build，部署时只需 server/dist 与 server/db
ExecStart=/usr/bin/env node server/dist/index.js
Restart=on-failure
RestartSec=3
# 转码需要读取媒体目录与访问 GPU
# 前端需单独构建并部署到 Nginx；此服务只监听 API。
Nice=-5

[Install]
WantedBy=multi-user.target
