# 要托管的番剧根目录（必填，也可以用 BANGUMI_ROOT）
BANGUMI_ROOT=/home/sakana/bangumi
# 监听地址与端口
HOST=0.0.0.0
PORT=8088
# 可选：ffmpeg / ffprobe 可执行文件路径（默认依次找环境变量、项目 tools/、PATH）
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# 可选：H.265 实时转码参数（默认 hevc_videotoolbox 不可用时会改用 software / libx265 / hevc_vaapi，自动探测）
# TRANSCODE_VIDEO_CODEC=libx265
# TRANSCODE_VIDEO_PRESET=veryfast
# TRANSCODE_VIDEO_BITRATE=6M
# TRANSCODE_HWACCEL=
