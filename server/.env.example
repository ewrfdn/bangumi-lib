# 后端环境变量：将此文件复制为 server/.env
# 媒体库：种类与 id 由代码固定，环境变量只提供根目录
# 番剧库（必定存在），未配置时回退 BANGUMI_ROOT / MEDIA_ROOT / ~/bangumi
BANGUMI_LIBRARY=/home/sakana/bangumi
# Windows 路径使用正斜杠，例如 D:/Anime；Docker 使用容器内的挂载路径
# 电影库：不配置则不存在该媒体库
# MOVIE_LIBRARY=/home/sakana/films
# MEDIA_LIBRARIES 已废弃，保留配置会阻止启动
# 后端监听地址与端口；Docker Compose 中 PORT 是前端对外端口，后端内部固定 8088
HOST=0.0.0.0
PORT=8088
# 前端端口和 API 代理地址在 web/.env 中单独配置，参照 web/.env.example
# 访问密钥：配置后开启登录；留空则保持内网免登录。修改后重启服务。
AUTH_SECRET=
# SQLite 自动创建，用于保存播放进度和登录会话（相对路径以项目根目录为准）
DB_PATH=./data/anishare.sqlite
# 定时任务注册文件；默认 server/config/tasks.yaml，修改后热加载
# TASKS_CONFIG=./server/config/tasks.yaml
# 登录有效期（天）
SESSION_DAYS=30
# 使用 HTTPS 反向代理时设为 1；普通 HTTP 内网访问保持 0
COOKIE_SECURE=0
# 可选：允许直接访问 API 的前端 Origin，逗号分隔；Vite/Nginx 同源代理不需要设置
# FRONTEND_ORIGINS=http://localhost:6001
# Pi 模型初始配置（也可登录“后台配置”页面保存到 SQLite，保存后立即生效）
# 后台和 Agent 接口必须先配置 AUTH_SECRET；这些变量不要使用 VITE_ 前缀
AI_ENABLED=0
AI_API_FORMAT=openai-completions
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_MAX_TOKENS=2048
AI_TIMEOUT_MS=30000
# 可选：32 字节密钥的 Base64；留空时自动创建 data/ai-config.key，备份时和数据库一起保留
# AI_CONFIG_KEY=
# 联网搜索（DeepSeek Search / Fetch API）：同样可在后台「模型服务 → 联网搜索」保存到 SQLite
DEEPSEEK_SEARCH_API_KEY=
AI_SEARCH_ENABLED=0
AI_SEARCH_BASE_URL=https://api.deepseek.com
AI_SEARCH_COUNT=8
AI_SEARCH_NEED_CONTENT=1
AI_SEARCH_TIMEOUT_MS=15000
AI_SEARCH_REUSE_MODEL_KEY=0
# 单条影视元数据：每个来源独立代理；空代理地址表示直连，修改配置后重启后端。
BANGUMI_CRAWLER_ENABLED=1
BANGUMI_CRAWLER_PROXY_URL=
# 请将 your-id 改为开发者标识；开源应用在 UA 中附上项目主页。
BANGUMI_CRAWLER_USER_AGENT=your-id/bangumi-lib/1.0
BANGUMI_CRAWLER_TIMEOUT_MS=15000
BANGUMI_CRAWLER_OPERATION_TIMEOUT_MS=35000
BANGUMI_CRAWLER_MAX_RETRIES=1
BANGUMI_CRAWLER_MIN_INTERVAL_MS=1000
# 普通公开条目可留空；需要授权的内容再配置 Token。
BANGUMI_CRAWLER_TOKEN=
# 豆瓣仅预留独立配置，当前尚未提供该来源实现。
DOUBAN_CRAWLER_ENABLED=0
DOUBAN_CRAWLER_PROXY_URL=
DOUBAN_CRAWLER_TIMEOUT_MS=20000
# 可选：ffmpeg / ffprobe 可执行文件路径（默认依次找环境变量、项目 tools/、PATH）
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# 可选：转为浏览器兼容的 H.264，自动探测硬件编码器，不可用时回退 libx264
# TRANSCODE_VIDEO_CODEC=libx264
# TRANSCODE_VIDEO_PRESET=veryfast
# TRANSCODE_VIDEO_BITRATE=6M
# TRANSCODE_HWACCEL=
# 可选：字幕 VTT 缓存（DATA_DIR/subtitles）。内挂字幕首次提取需顺序读完整视频，
# 首次请求会边提取边流式返回；提取结果按文件版本缓存，SUBTITLE_CACHE_MAX_MB=0 不启用上限清理。
# SUBTITLE_CACHE_MAX_MB=256
# 单个内挂字幕提取的兜底超时（毫秒），慢速网络存储可调大
# SUBTITLE_EXTRACT_TIMEOUT_MS=1800000
